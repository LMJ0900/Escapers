# backend/.env.example  (커밋됨 - 이 파일을 .env 로 복사해 사용한다)

# API 포트
PORT=4000
# CORS 허용 프론트 오리진
CORS_ORIGIN=http://localhost:3000

# PostgreSQL 접속 URL (루트 docker-compose.yml 기준)
DATABASE_URL=postgresql://escapers:escapers@localhost:5432/escapers

# JWT 서명 키 (32자 이상). 로컬 개발용 예시값이며 배포 환경에서는 반드시 교체한다.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-0123456789
# 토큰 수명(초). 프론트 쿠키 maxAge(constant/token)와 맞춘다: 15분 / 14일
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

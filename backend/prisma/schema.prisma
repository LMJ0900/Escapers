// 백엔드 명세서 §5 데이터 모델. 인증에 필요한 엔티티부터 추가한다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  nickname       String         @unique
  role           UserRole       @default(MEMBER)
  status         UserStatus     @default(ACTIVE)
  marketingAgree Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  consents       UserConsent[]
  refreshTokens  RefreshToken[]
}

model UserConsent {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     ConsentType
  agreed   Boolean
  agreedAt DateTime    @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// refreshJwt 원문의 SHA-256 해시. 원문은 저장하지 않는다.
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

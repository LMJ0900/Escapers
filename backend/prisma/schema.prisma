// 백엔드 명세서 §5 데이터 모델. 인증에 필요한 엔티티부터 추가한다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  OWNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  nickname       String         @unique
  role           UserRole       @default(MEMBER)
  status         UserStatus     @default(ACTIVE)
  marketingAgree Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  consents       UserConsent[]
  refreshTokens  RefreshToken[]
  themeLikes     ThemeLike[]
  reviews        Review[]
  reviewHelpfuls ReviewHelpful[]
}

model UserConsent {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     ConsentType
  agreed   Boolean
  agreedAt DateTime    @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// refreshJwt 원문의 SHA-256 해시. 원문은 저장하지 않는다.
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── 테마 · 지점 · 크롤링 (백엔드 명세서 §5, §7.3) ──

/// 정규화된 장르. 원본 표기는 Theme.genreRaw 에 보관한다.
enum ThemeGenre {
  HORROR
  THRILLER
  MYSTERY
  SF
  FANTASY
  ADVENTURE
  DRAMA
  ROMANCE
  COMEDY
  IMMERSIVE
  OUTDOOR
  ETC
}

enum ThemeActivityLevel {
  HIGH
  MEDIUM
  LOW
}

enum ThemeStatus {
  OPEN
  CLOSED
}

enum CrawlEngine {
  CHEERIO
  PLAYWRIGHT
}

enum CrawlRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

model Brand {
  id       String   @id @default(cuid())
  name     String   @unique
  branches Branch[]
  sources  Source[]
}

model Branch {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  name       String
  /// 사이트가 쓰는 지점 식별자 (예: nextedition 의 "geondae-1")
  externalId String?
  /// 시/도 + 시/군/구 (예: "서울 광진구")
  region     String
  address    String
  lat        Float?
  lng        Float?
  phone      String?
  themes     Theme[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([brandId, name])
}

model Theme {
  id              String              @id @default(cuid())
  branchId        String
  branch          Branch              @relation(fields: [branchId], references: [id])
  name            String
  genre           ThemeGenre
  genreRaw        String?
  /// 1~5. 사이트에 정보가 없으면 null
  difficulty      Int?
  activityLevel   ThemeActivityLevel?
  /// 1인 기준 최저가(원). 사이트에 정보가 없으면 null
  priceFrom       Int?
  minPlayers      Int?
  maxPlayers      Int?
  playTimeMin     Int?
  description     String?
  /// 원본 포스터 URL. 오브젝트 스토리지 이전 전까지 임시로 사용
  imageUrl        String?
  /// 원본 예약 · 상세 페이지
  detailUrl       String?
  status          ThemeStatus         @default(OPEN)
  popularityScore Float               @default(0)
  /// 소스가 부여한 테마 ID. 수동 등록 테마는 null
  externalId      String?
  sourceId        String?
  source          Source?             @relation(fields: [sourceId], references: [id])
  /// 마지막으로 크롤링 결과에서 확인된 시각
  lastSeenAt      DateTime?
  likes           ThemeLike[]
  slots           Slot[]
  reviews         Review[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([sourceId, externalId])
  @@index([genre])
  @@index([popularityScore])
}

model ThemeLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  themeId   String
  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, themeId])
  /// 최근 30일 좋아요 수 집계(popularityScore 배치)용
  @@index([themeId, createdAt])
}

/// 특정 테마의 특정 일시 예약 단위 (백엔드 명세서 §5). crawl:slots 가 upsert 한다.
model Slot {
  id         String   @id @default(cuid())
  themeId    String
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  available  Boolean
  /// 1인 기준 가격(원). 사이트에 정보가 없으면 null
  price      Int?
  /// 마지막으로 크롤링 결과에서 확인된 시각
  lastSeenAt DateTime

  @@unique([themeId, startsAt])
}

// ── 리뷰 (요구사항 명세서 §3.5, §4) ──

enum ReviewStatus {
  PUBLISHED
  DELETED
}

model Review {
  id               String          @id @default(cuid())
  themeId          String
  theme            Theme           @relation(fields: [themeId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1~5
  rating           Int
  cleared          Boolean
  /// 탈출 성공 시 남은 시간(초). 실패면 null
  remainingSeconds Int?
  hintCount        Int?
  playerCount      Int?
  content          String
  photoUrls        String[]
  hasSpoiler       Boolean         @default(false)
  playedAt         DateTime?
  /// ReviewHelpful 개수. 정렬 · 커서용으로 비정규화해 둔다
  helpfulCount     Int             @default(0)
  /// 삭제는 소프트 삭제 (FR-REV-03)
  status           ReviewStatus    @default(PUBLISHED)
  helpfuls         ReviewHelpful[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([themeId, status])
}

/// 리뷰 "도움돼요". 회원당 리뷰별 1회
model ReviewHelpful {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, reviewId])
  @@index([reviewId])
}

model Source {
  id                  String      @id @default(cuid())
  brandId             String
  brand               Brand       @relation(fields: [brandId], references: [id])
  adapterKey          String      @unique
  baseUrl             String
  engine              CrawlEngine
  crawlIntervalSec    Int         @default(300)
  maxConcurrency      Int         @default(1)
  enabled             Boolean     @default(true)
  lastSuccessAt       DateTime?
  consecutiveFailures Int         @default(0)
  themes              Theme[]
  crawlRuns           CrawlRun[]
}

model CrawlRun {
  id         String         @id @default(cuid())
  sourceId   String
  source     Source         @relation(fields: [sourceId], references: [id])
  /// "themes" | "slots"
  kind       String
  /// crawl:themes 의 실행 사유 (INITIAL · CHANGE_DETECTED · WEEKLY · MANUAL)
  reason     String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  status     CrawlRunStatus @default(RUNNING)
  /// 수집 건수 요약 (created · updated · closed · invalid 등)
  stats      Json?
  error      String?

  @@index([sourceId, startedAt])
}

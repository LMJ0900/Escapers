# .env.development  (커밋됨 - 팀 공통)

# 기본 개발 서버(npm run dev)는 실제 백엔드에 붙는다. 백엔드 주소는 .env.local 등에서 지정한다.
# MSW 목킹으로 띄우려면 npm run dev:mock (루트: npm run dev:front:mock) 을 사용한다.
#   → 스크립트가 NEXT_PUBLIC_API_MOCKING=enabled 를 주입한다.
NEXT_PUBLIC_API_BASE_URL=

# 테마 상세의 지도는 카카오맵 JavaScript 키가 있어야 그려진다(없으면 주소만 보여주는 폴백 화면).
# 키는 커밋하지 말고 .env.local 에 둔다. 카카오 개발자 콘솔에서 허용 도메인(http://localhost:3000)을 등록해야 한다.
#   NEXT_PUBLIC_KAKAO_MAP_APP_KEY=<JavaScript 키>
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

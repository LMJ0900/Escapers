{
  "name": "escapers",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:front": "npm run dev -w @escapers/frontend",
    "dev:back": "npm run dev -w @escapers/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "createComponent": "npm run createComponent -w @escapers/frontend --"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
